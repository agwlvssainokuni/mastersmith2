root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,kt,kts}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,mjs,cjs,css,json,html}]
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

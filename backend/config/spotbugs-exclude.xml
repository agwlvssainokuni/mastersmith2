<!-- SpotBugs の対象から外すもの。外す理由を必ず書く。 -->
<FindBugsFilter>
  <!--
    PREDICTABLE_RANDOM の誤検知（Intent 260925-user-management の B1 で確かめた。team.md の Code Style、NFR2.9）。
    LoginAttemptStateRepository.lockDummyForUpdate の ThreadLocalRandom は、存在しないメールアドレスのログインの試みで、
    8 行のダミーの行がすべてほかの試みに排他を持たれているときに、待つ行を 1 つ選ぶためだけに使う。選んだ番号（-1〜-8）は
    応答・ログ・DB の値に出ず、秘密・トークン・推測されて困る値の元にならない。予測できても、攻撃者は同じダミーの行を待たせる
    ことしかできず、その行の待ちの上限（3 秒）と応答の時間の揃え方は変わらない。そのため、この1か所だけを外す。
  -->
  <Match>
    <Class name="cherry.mastersmith.auth.repository.LoginAttemptStateRepository" />
    <Method name="lockDummyForUpdate" />
    <Bug pattern="PREDICTABLE_RANDOM" />
  </Match>
  <!--
    業務データの行の SQL の部品の SQL_ の指摘（Intent 261016-business-data-views の U1、BR3.3・BR3.5・BR11.4、team.md の Code Style、
    コード生成の計画の A2 で承認済み）。RowSqlExecutor は、業務データの SQL を組み立てて実行する唯一の部品で、search・detail の本体
    だけが文を作る（BusinessDataBoundaryArchitectureTest で、java.sql.Connection の prepareStatement・createStatement を呼べる場所を
    この2つのメソッドだけに絞っている）。文に入る識別子（スキーマ名・テーブル名・カラム名・並べ替えの列）は、要求1件の権限の写しの
    DSL の名前と文字どおり照らしたうえで、種類ごとの名前の一覧（KnownIdentifiers）にあるものだけを SqlIdentifiers.quoteKnown で引用し
    （一覧に無い名前は文を作らずに失敗する）、値（検索の値・主キーの値・ページの上限と読み飛ばす数）はすべてバインド変数で渡す。ほか
    は定数の形の文字だけ。そのため、このクラスの2つのメソッドの、この2つのパターンだけを外す（パッケージや SQL_ の全体では外さない）。

    書き込みのメソッド（Intent 261016-business-data-views の U2、BR7.1・BR13.3、U2 のコード生成の計画の A3 で承認済み）:
    precheckUnique・insert・update・delete・inspectViolation の本体も文を作る（境界テストで、文を作れる場所をこの5つと search・detail
    だけに絞っている）。書き込みの文の識別子も、要求1件の権限の写しの DSL の種類ごとの名前の一覧と照らしたものだけを
    SqlIdentifiers.quoteKnown で引用し（外部キーの参照先のカラムは、参照先のテーブルの DSL のカラムの一覧と照らす）、値（作成・更新の
    値・主キーの値・事前の問い合わせと確かめの値）はすべてバインドする。ほかは定数の形の文字（INSERT・UPDATE・DELETE・SELECT の
    骨組みと DEFAULT VALUES など）だけ。
  -->
  <Match>
    <Class name="cherry.mastersmith.businessdata.repository.RowSqlExecutor" />
    <Or>
      <Method name="search" />
      <Method name="detail" />
      <Method name="precheckUnique" />
      <Method name="insert" />
      <Method name="update" />
      <Method name="delete" />
      <Method name="inspectViolation" />
    </Or>
    <Or>
      <Bug pattern="SQL_INJECTION_JDBC" />
      <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING" />
    </Or>
  </Match>
</FindBugsFilter>

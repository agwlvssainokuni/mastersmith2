<!--
  アプリのログの設定。標準出力への出力を1つだけ置き、1行1件の JSON で同期して書く。
  項目: timestamp（ISO 8601、タイムゾーン付き）、level、logger、thread、message（改行は「 ⏎ 」に置き換える）、
        traceId・spanId（MDC のうちこの2つだけ）、呼び出し側のキーと値、exception（あれば）。
  呼び出し元の場所・ホスト名は出さない。ファイルへの出力は持たない。
  外部エクスポートの送信（OpenTelemetry の logback 用の出力）は、有効にしたときだけアプリが加える。
-->
<configuration>
  <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <fieldName>timestamp</fieldName>
          <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
        </timestamp>
        <logLevel>
          <fieldName>level</fieldName>
        </logLevel>
        <loggerName>
          <fieldName>logger</fieldName>
        </loggerName>
        <threadName>
          <fieldName>thread</fieldName>
        </threadName>
        <!-- メッセージの中の改行は「 ⏎ 」に置き換えて、値に改行を残さない（1件を1行で読めるようにする）。 -->
        <provider class="cherry.mastersmith.common.observability.SingleLineMessageJsonProvider">
          <fieldName>message</fieldName>
        </provider>
        <mdc>
          <includeMdcKeyName>traceId</includeMdcKeyName>
          <includeMdcKeyName>spanId</includeMdcKeyName>
        </mdc>
        <keyValuePairs/>
        <stackTrace>
          <fieldName>exception</fieldName>
        </stackTrace>
      </providers>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="JSON_STDOUT"/>
  </root>
</configuration>

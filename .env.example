# 環境変数の見本。複写して .env を作り、値を入れる（.env は Git 管理外。コミットしない）。
#   cp .env.example .env
# 値を空のままにした行は「空の値」として渡る。既定値を使う設定は、行ごとコメントのままにしておく。

# ---- コンテナ（docker compose）----
# colima の VM は CPU 4・メモリ 6GiB を前提にする（README の「コンテナの資源の上限」）。
# アプリのコンテナの CPU の上限（既定 4）。Docker の VM の CPU が 4 に満たない PC では下げる。
# 照合の時間の目標（同時 10 件のログインで 1 秒以内）は 4 が前提。
# MASTERSMITH_CONTAINER_CPUS=
# アプリのコンテナのメモリの上限（既定 1g。2g・1536m の形）。1g のままでは高い負荷でメモリの上限で止まりうる。
# VM を CPU 4・メモリ 6GiB にした PC では 2g にする。
# MASTERSMITH_CONTAINER_MEMORY=
# JVM に足す引数（既定なし。空白で区切る。例: -XX:MaxRAMPercentage=70.0 -XX:MaxMetaspaceSize=256m）。
# 既定の引数（最大ヒープはメモリの上限の 75%、タイムゾーン Asia/Tokyo）の後ろに置くため、同じ指定は上書きになる。
# MASTERSMITH_JAVA_OPTIONS=

# ---- 内部DB（H2）----
# 接続先。既定は組み込み・ファイル保存（jdbc:h2:file:./data/mastersmith;DEFRAG_ALWAYS=TRUE、コンテナでは /app/data/mastersmith）。
# 上書きするときも ;DEFRAG_ALWAYS=TRUE を付ける（停止時にファイルを詰め直す。付けないと DSL の履歴を消してもファイルが縮まない）。
# MASTERSMITH_DB_URL=
# MASTERSMITH_DB_USERNAME=
# 内部DBのパスワード（秘密情報）。最初に作った DB と同じ値にする。
MASTERSMITH_DB_PASSWORD=
# 接続プールの接続の数の上限（既定 30）。同時の要求がこの数に達すると監査の記録が欠けうる（README の「監査ログ（U4）」の既知の制約）。
# MASTERSMITH_DB_MAXIMUM_POOL_SIZE=

# ---- 対象DB（U1。利用者の業務データの DB。MySQL・MariaDB・PostgreSQL）----
# 7つの項目（種類・ホスト・番号・DB の名前・スキーマ・ユーザー名・パスワード）がすべて空なら、対象DB を使わない（起動は続く）。
# 一部だけ空・不正なら、項目の名前だけを WARN で出して使わない。アカウントは読み取りの権限だけにすることを勧める。
# 種類（mysql・mariadb・postgresql）
# MASTERSMITH_TARGET_DB_TYPE=
# ホスト名（例: 手元で試す対象DB なら targetdb-postgres・targetdb-mysql・targetdb-mariadb）と番号（1〜65535）
# MASTERSMITH_TARGET_DB_HOST=
# MASTERSMITH_TARGET_DB_PORT=
# DB の名前とスキーマの名前（MySQL・MariaDB は同じ値）
# MASTERSMITH_TARGET_DB_DATABASE=
# MASTERSMITH_TARGET_DB_SCHEMA=
# ユーザー名とパスワード（秘密情報）
# MASTERSMITH_TARGET_DB_USERNAME=
# MASTERSMITH_TARGET_DB_PASSWORD=
# 接続の待ちの上限（既定 3s）、問い合わせ1回の待ちの上限（生成 既定 20s・照合 既定 5s）。読み取りの全体の上限は無い
# MASTERSMITH_TARGET_DB_CONNECT_TIMEOUT=
# MASTERSMITH_TARGET_DB_QUERY_TIMEOUT_GENERATE=
# MASTERSMITH_TARGET_DB_QUERY_TIMEOUT_COMPARE=
# 接続の数の上限（既定 5）と、使っていない接続を閉じるまでの時間（既定 60s）
# MASTERSMITH_TARGET_DB_POOL_MAXIMUM_SIZE=
# MASTERSMITH_TARGET_DB_POOL_IDLE_TIMEOUT=

# ---- DSL の管理（U4）----
# 投入の API（POST /api/admin/dsl/preview）だけの要求の本文の上限（既定 10MB。ほかの API は MASTERSMITH_WEB_MAX_REQUEST_BODY_SIZE）
# MASTERSMITH_DSL_MAX_SUBMIT_SIZE=
# 適用の履歴の件数の上限（既定 20、1 以上）
# MASTERSMITH_DSL_HISTORY_LIMIT=

# ---- 手元で試す対象DB（compose の profile targetdb-postgres・targetdb-mysql・targetdb-mariadb）----
# 見本の DB の管理者のパスワードと、読み取りだけのアカウント mastersmith_reader のパスワード（秘密情報。空だと DB を作れない）。
# アプリから見本の DB を読むときは、MASTERSMITH_TARGET_DB_USERNAME=mastersmith_reader と、読み取りのパスワードを入れる。
MASTERSMITH_SAMPLE_TARGETDB_ADMIN_PASSWORD=
MASTERSMITH_SAMPLE_TARGETDB_READER_PASSWORD=

# ---- ヘルスチェック ----
# 内部DBの確認の制限時間（既定 2s）
# MASTERSMITH_HEALTH_DB_TIMEOUT=

# ---- Web ----
# エラー応答の type の URL のベースURL（プロキシを置く配備で固定する。例: https://mastersmith.example.com）
# MASTERSMITH_WEB_BASE_URL=
# 転送元のヘッダー（X-Forwarded-*・Forwarded）を信頼するか（既定 false。プロキシの内側からだけ受け付けるときだけ true）
# MASTERSMITH_WEB_TRUST_FORWARDED_HEADERS=
# 要求の本文の大きさの上限（既定 1MB）
# MASTERSMITH_WEB_MAX_REQUEST_BODY_SIZE=

# ---- 観測性（外部エクスポート・トレース）----
# 外部エクスポート（トレース・ログ・指標の OTLP の送信）を有効にするか（既定 false）
# MASTERSMITH_OBSERVABILITY_EXPORT_ENABLED=
# OTLP の受け手のベースURL（既定 http://localhost:4318。確認用の受け手なら http://otel-collector:4318、手元の監視（profile monitoring）なら http://lgtm:4318）
# MASTERSMITH_OBSERVABILITY_EXPORT_ENDPOINT=
# 外部へ送るトレースの割合（0.0〜1.0、既定 1.0）
# MASTERSMITH_TRACING_SAMPLING_PROBABILITY=

# ---- メソッドの呼び出しの追跡（TraceAspect。対象のクラスのロガーを TRACE にしたときだけ出る）----
# 対象のクラスの名前のロガーを使うか（既定 true）
# MASTERSMITH_TRACE_USE_DYNAMIC_LOGGER=
# 代理のクラス（プロキシ）の名前を隠すか（既定 true）
# MASTERSMITH_TRACE_HIDE_PROXY_CLASS_NAMES=
# 例外のときにスタックトレースを出すか（既定 true）
# MASTERSMITH_TRACE_LOG_EXCEPTION_STACK_TRACE=
# 入る・出る・例外の文言（既定は application.yaml を参照）
# MASTERSMITH_TRACE_ENTER_MESSAGE=
# MASTERSMITH_TRACE_EXIT_MESSAGE=
# MASTERSMITH_TRACE_EXCEPTION_MESSAGE=

# ---- U2（認証）で使う秘密情報 ----
# アクセストークンの署名鍵（必須）: 32 バイト以上の乱数を Base64 にした文字列。
# 無い・短いとアプリは起動しません。作り方の例: openssl rand -base64 32
MASTERSMITH_AUTH_SIGNING_KEY=
# 初期管理者のメールアドレスとパスワード（任意）。
# 正しく設定して起動すると、その利用者がいなければ管理者として作られます。
# 無い・正しくないときは作らずに警告を出し、起動は続きます。パスワードは 12 文字以上、UTF-8 で 72 バイト以内。
MASTERSMITH_AUTH_INITIAL_ADMIN_EMAIL=
MASTERSMITH_AUTH_INITIAL_ADMIN_PASSWORD=

# ---- U2（認証）の任意の設定（既定値のままでよければ書かない）----
# アクセストークンの有効期限（既定 5m）
# MASTERSMITH_AUTH_ACCESS_TOKEN_TTL=
# リフレッシュトークンの有効期限（既定 24h。Cookie の寿命も同じ）
# MASTERSMITH_AUTH_REFRESH_TOKEN_TTL=
# ロックするまでの連続失敗回数（既定 5、1 以上）
# MASTERSMITH_AUTH_LOCK_THRESHOLD=
# ロックの時間（既定 30m）
# MASTERSMITH_AUTH_LOCK_DURATION=
# パスワードのハッシュ（bcrypt）の cost（既定 12、4〜31）
# MASTERSMITH_AUTH_PASSWORD_BCRYPT_COST=
# 無効・期限切れのリフレッシュトークンを、期限からどれだけ残してから消すか（既定 7d）
# MASTERSMITH_AUTH_REFRESH_TOKEN_CLEANUP_RETENTION=
# 削除を行う時刻（Spring の cron の形。既定は毎日 3 時 30 分）
# MASTERSMITH_AUTH_REFRESH_TOKEN_CLEANUP_CRON=

{
  "name": "mastersmith-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write . && prettier --write --config .prettierrc.json ../scripts",
    "format:check": "prettier --check . && prettier --check --config .prettierrc.json ../scripts",
    "lint": "oxlint . && eslint . && npm run lint:scripts",
    "lint:scripts": "cd .. && frontend/node_modules/.bin/oxlint -c frontend/.oxlintrc.json scripts && frontend/node_modules/.bin/eslint --config frontend/eslint.config.js scripts",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "license:check": "node scripts/check-license-header.mjs",
    "svg:check": "node scripts/check-svg-safety.mjs",
    "dist:check": "node scripts/check-dist-assets.mjs",
    "bundle:size": "node scripts/check-bundle-size.mjs",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "i18next": "^27.1.1",
    "make-you-chic-ui": "file:../vendor/make-you-chic-ui/packages/make-you-chic-ui",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}

    {
      "id": 2,
      "type": "stat",
      "title": "稼働（5xx でない応答の割合、30 日）",
      "description": "仮の目標 99.5%（U1 の monitoring-design.md 3章の候補）。見ている期間にしかデータが無い点に注意",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_requests_milliseconds_count{service_name=\"mastersmith\",status=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_server_requests_milliseconds_count{service_name=\"mastersmith\"}[30d])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      }
